# ==============================================================================
# CodeGuard AI — Environment Configuration Template
# ==============================================================================

# Node / Environment
NODE_ENV=production
PORT=5000

# Service URLs
API_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Database Configuration (Microsoft SQL Server Express)
# ==============================================================================
# For Docker containers, use SQLSERVER_HOST=host.docker.internal
# For local bare-metal processes, use SQLSERVER_HOST=localhost
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=54833
SQLSERVER_DATABASE=CodeGuardAI
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_sql_server_password

# ==============================================================================
# JWT & Authentication Secrets (Generate with `openssl rand -base64 32`)
# ==============================================================================
JWT_ACCESS_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# AI Provider Architecture Configuration
# Failover order: NVIDIA (Primary) -> OpenRouter -> OpenAI -> Gemini -> AST Fallback
# ==============================================================================
AI_PROVIDER=nvidia

# 1. NVIDIA NIM (PRIMARY)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# 2. OpenRouter (SECONDARY)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. OpenAI (TERTIARY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. Google Gemini AI Service (QUATERNARY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379

# Email Configuration (SMTP)
# For local Docker development (Mailpit):
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@codeguardai.com
EMAIL_FROM_NAME=CodeGuard AI
EMAIL_SECURE=false
EMAIL_TLS=false

# For production external SMTP (e.g. Amazon SES, SendGrid, Mailgun, SMTP Relay):
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=CodeGuard AI
# EMAIL_SECURE=false
# EMAIL_TLS=true