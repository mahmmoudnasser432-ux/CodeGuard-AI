# ==============================================================================
# CodeGuard AI — Environment Configuration Template
# ==============================================================================

# Node / Environment
NODE_ENV=production
PORT=5000

# Service URLs
API_URL=https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
AI_SERVICE_URL=https://ai-service.yourdomain.com
NEXT_PUBLIC_BACKEND_API_URL=https://api.yourdomain.com
FRONTEND_URL=https://codeguard-ai.vercel.app
CORS_ORIGIN=https://codeguard-ai.vercel.app

# Database (Supabase PostgreSQL / Relational DB)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Legacy SQL Server (Optional if self-hosting MSSQL)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=CodeGuardAI
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrongPassword_123

# JWT & Authentication Secrets (Generate with `openssl rand -base64 32`)
JWT_SECRET=your-32-byte-base64-random-access-secret
JWT_ACCESS_SECRET=your-32-byte-base64-random-access-secret
JWT_REFRESH_SECRET=your-32-byte-base64-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NVIDIA NIM (PRIMARY)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# OpenRouter (SECONDARY)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenAI (TERTIARY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini AI Service (QUATERNARY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Provider failover order: nvidia -> openrouter -> openai -> gemini -> fallback
# Set to: nvidia | openrouter | openai | gemini
AI_PROVIDER=nvidia



# Supabase Storage & Services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=CodeGuard AI
EMAIL_SECURE=false
EMAIL_TLS=true