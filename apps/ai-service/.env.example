# ==============================================================================
# CodeGuard AI Service — Environment Variables Template
# ==============================================================================

PORT=8000

# Provider Selection (nvidia | openrouter | openai | gemini)
# Failover order: Primary -> Next in chain -> Deterministic AST Fallback
AI_PROVIDER=nvidia

# 1. NVIDIA NIM (PRIMARY)
# Get a key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# 2. OpenRouter (SECONDARY)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. OpenAI (TERTIARY)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 4. Google Gemini (QUATERNARY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
