# ==============================================================================
# CodeGuard AI API — Environment Configuration Template
# ==============================================================================
# NOTE: This file is a template only. Real secrets must never be committed.
# - Local development: Copy to .env and configure local development values.
# - Production runtime: Configure secrets via Railway Service Variables
#   (Railway Sealed Variables for production secrets) and Vercel Environment Variables.
# ==============================================================================

NODE_ENV=production
PORT=5000

API_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
# AI Service URL
# Use AI_SERVICE_URL=http://ai-service:8000 inside Docker, or http://127.0.0.1:8000 for local bare-metal dev
AI_SERVICE_URL=http://ai-service:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Microsoft SQL Server Configuration
# ==============================================================================
# For local Development (Docker <-> Windows host SQL Express):
#   SQLSERVER_HOST=host.docker.internal
#   SQLSERVER_PORT=54833
#   SQLSERVER_USER=sa
#   SQLSERVER_TRUST_SERVER_CERTIFICATE=true
#
# For production deployment (e.g. Managed Azure SQL Database):
#   SQLSERVER_HOST=<your-server-name>.database.windows.net
#   SQLSERVER_PORT=1433
#   SQLSERVER_DATABASE=CodeGuardAI
#   SQLSERVER_USER=codeguard_app_user
#   SQLSERVER_PASSWORD=<injected-via-railway-sealed-variables>
#   SQLSERVER_ENCRYPT=true
#   SQLSERVER_TRUST_SERVER_CERTIFICATE=false
#   # Optional: only needed if connection hostname differs from certificate DNS name
#   # SQLSERVER_SERVER_NAME=<your-server-name>.database.windows.net
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=54833
SQLSERVER_DATABASE=CodeGuardAI
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_sql_server_password
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
# SQLSERVER_SERVER_NAME=

# Connection Pool & Timeout Configuration
SQLSERVER_CONNECTION_TIMEOUT=15000
SQLSERVER_REQUEST_TIMEOUT=30000
SQLSERVER_POOL_MIN=2
SQLSERVER_POOL_MAX=20
SQLSERVER_POOL_IDLE_TIMEOUT=30000

# JWT Secrets
JWT_ACCESS_SECRET=generate-a-strong-random-secret
JWT_REFRESH_SECRET=generate-a-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional in development; required in production)
# Docker Compose API service should use redis://redis:6379
# Production must use a managed or internal Redis URL (redis:// or rediss://), not localhost
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Email Configuration
# For local Docker development (Mailpit):
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@codeguardai.com
EMAIL_FROM_NAME=CodeGuard AI
EMAIL_SECURE=false
EMAIL_TLS=false

# For production external SMTP (e.g. Amazon SES, SendGrid, Mailgun, SMTP Relay):
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=CodeGuard AI
# EMAIL_SECURE=false
# EMAIL_TLS=true
