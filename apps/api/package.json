{
  "name": "@codeguard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run tests/health.test.ts",
    "test:all": "vitest run",
    "test:e2e": "vitest run tests/analyses.api.test.ts",
    "test:nvidia": "python -m pytest ../ai-service/tests/test_nvidia_provider.py -v",
    "test:providers": "python -m pytest ../ai-service/tests/test_nvidia_provider.py ../ai-service/tests/test_failover_scenarios.py ../ai-service/tests/test_provider_abstraction.py -v",
    "migrate": "tsx src/migration-runner.ts",

    "seed": "tsx src/seed-runner.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^11.0.1",
    "nodemailer": "^9.0.5",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.9.0",
    "supertest": "^7.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "4.1.10"
  }
}
